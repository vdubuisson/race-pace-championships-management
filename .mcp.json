{
	"mcpServers": {
		"angular-cli": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@angular/cli",
				"mcp"
			],
			"tools": [
				"*"
			]
		},
		"taiga-ui": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@taiga-ui/mcp@latest",
				"--source-url=https://taiga-ui.dev/llms-full.txt"
			],
			"tools": [
				"*"
			]
		}
	}
}
