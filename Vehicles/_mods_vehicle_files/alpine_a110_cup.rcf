<?xml version="1.0" encoding="utf-8" ?>
<REPLACEMENT_SYSTEM>
	<!-- INPUTS section describes all inputs which can control selection of replacement items -->
	<INPUTS>
		<INPUT NAME="LIVERY" OPTIONS="15" />
		<INPUT NAME="TIRE" OPTIONS="6" />
		<INPUT NAME="DIRTTYPE" OPTIONS="3" />
	</INPUTS>

	<NAMES INPUT ="LIVERY">
		<NAME LIVERY="1" NAME="#37" />
		<NAME LIVERY="2" NAME="#38" />
		<NAME LIVERY="3" NAME="#60" />
		<NAME LIVERY="4" NAME="#61" />
		<NAME LIVERY="110" NAME="#110" />
		<NAME LIVERY="69" NAME="#69" />
		<NAME LIVERY="11" NAME="#11" />
		<NAME LIVERY="5" NAME="#27" />
		<NAME LIVERY="6" NAME="#28" />
		<NAME LIVERY="7" NAME="#24" />
		<NAME LIVERY="8" NAME="#25" />
		<NAME LIVERY="9" NAME="#21" />
		<NAME LIVERY="10" NAME="#22" />
		<NAME LIVERY="13" NAME="#8" />
		<NAME LIVERY="14" NAME="#9" />
	</NAMES>

	<NAMES INPUT ="TIRE">
		<NAME TIRE="1" NAME="Soft" />
		<NAME TIRE="2" NAME="Medium" />
		<NAME TIRE="3" NAME="Hard" />
		<NAME TIRE="4" NAME="Intermediate" />
		<NAME TIRE="5" NAME="Wet" />
		<NAME TIRE="6" NAME="Extreme" />
	</NAMES>

	<NAMES INPUT ="DIRTTYPE">
		<NAME DIRTTYPE="1" NAME="Dirt" />
		<NAME DIRTTYPE="2" NAME="Snow" />
		<NAME DIRTTYPE="3" NAME="Mud" />
	</NAMES>

	<!-- DEPENDENCY section describes inputs which depend on each other in that only some combinations are permitted -->
	<!-- this will only be used in game for the menu system, and in the editor -->

	<!-- CONDITION sections define what to replace and when to replace it		-->
	<!-- They are used in the same way for all situations				-->
	
	<!-- Simple case - exterior paint effecting two materials -->
	
	
	<CONDITION LIVERY="1">
		<REPLACE MATERIAL="vehicles\alpine_a110_cup\alpine_a110_gt4_paint" NEWMATERIAL="vehicles\_generic_materials\alpine_a110_cup_livery_37.mtx" />
		<REPLACE TEXTURE="Vehicles\Textures\common_tire_diff.dds" NEWTEXTURE="Vehicles\Textures\tire_michelin_audi_r18_diff_00.dds" />
		<REPLACE TEXTURE="Vehicles\Textures\common_tire_blur_diff.dds" NEWTEXTURE="Vehicles\Textures\tire_michelin_audi_r18_diff_01.dds" />
		<REPLACE TEXTURE="Vehicles\Textures\common_tire_nmp8888.dds" NEWTEXTURE="Vehicles\Textures\tire_michelin_audi_r18_nmp8888.dds" />
