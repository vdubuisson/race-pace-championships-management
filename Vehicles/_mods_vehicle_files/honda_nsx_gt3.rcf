<?xml version="1.0" encoding="utf-8" ?>
<REPLACEMENT_SYSTEM>
	<!-- INPUTS section describes all inputs which can control selection of replacement items -->
	<INPUTS>
		<INPUT NAME="LIVERY" OPTIONS="9" />
		<INPUT NAME="TIRE" OPTIONS="6" />
		<INPUT NAME="DIRTTYPE" OPTIONS="3" />
	</INPUTS>

	<NAMES INPUT ="LIVERY">
		<NAME LIVERY="51" NAME="Spa 24h 2018 Castrol Honda Racing #30" />
		<NAME LIVERY="52" NAME="Blancpain 2019 Team Jenson #22" />
		<NAME LIVERY="53" NAME="Bath 12h 2020 JAS Motorsport Honda #30" />
		<NAME LIVERY="54" NAME="IMSA 2017 Michael Shank Racing with CurbAgajanian #86" />
		<NAME LIVERY="55" NAME="IMSA 2017 Michael Shank Racing with Curb/Agajanian #93" />
		<NAME LIVERY="56" NAME="IMSA 2018 HART #69 Rolex 24 Daytona" />
		<NAME LIVERY="57" NAME="IMSA 2018 HART #69 Sahlen's 6hrs of The Glen" />
		<NAME LIVERY="58" NAME="IMSA 2021 Gradient Racing #66" />
		<NAME LIVERY="59" NAME="SGT 2018 Modulo Kenwood #34" />
	</NAMES>

	<NAMES INPUT ="TIRE">
		<NAME TIRE="1" NAME="Soft" />
		<NAME TIRE="2" NAME="Medium" />
		<NAME TIRE="3" NAME="Hard" />
		<NAME TIRE="4" NAME="Intermediate" />
		<NAME TIRE="5" NAME="Wet" />
		<NAME TIRE="6" NAME="Extreme" />
	</NAMES>

	<NAMES INPUT ="DIRTTYPE">
		<NAME DIRTTYPE="1" NAME="Dirt" />
		<NAME DIRTTYPE="2" NAME="Snow" />
		<NAME DIRTTYPE="3" NAME="Mud" />
	</NAMES>

	<!-- DEPENDENCY section describes inputs which depend on each other in that only some combinations are permitted -->
	<!-- this will only be used in game for the menu system, and in the editor -->

	<!-- CONDITION sections define what to replace and when to replace it		-->
	<!-- They are used in the same way for all situations				-->
	
	<!-- Simple case - exterior paint effecting two materials -->

	<CONDITION LIVERY="51">
		<REPLACE MATERIAL="vehicles\Acura_NSX_GT3\acura_nsx_gt3_paint" NEWMATERIAL="vehicles\_generic_materials\livery_generic_effects.mtx" />
		<REPLACE MATERIAL="vehicles\Acura_NSX_GT3\acura_nsx_gt3_paint_skin" NEWMATERIAL="vehicles\_generic_materials\livery_generic_effects_autoskin.mtx" />
		<REPLACE MATERIAL="Vehicles\Acura_NSX_GT3\acura_nsx_gt3_paint_cpit" NEWMATERIAL="Vehicles\_Generic_Materials\livery_generic_effects_autocpit.mtx" />
		<REPLACE MATERIAL="vehicles\Acura_NSX_GT3\acura_nsx_gt3_paint_cpit_skin" NEWMATERIAL="Vehicles\_Generic_Materials\livery_generic_effects_autoskin_autocpit.mtx" />
		<REPLACE TEXTURE="vehicles\textures\common_paint.dds" NEWTEXTURE="vehicles\textures\CustomLiveries\Honda_NSX_GT3\acura_nsx_gt3_livery51.dds" />
		<REPLACE TEXTURE="Vehicles\Textures\acura_nsx_gt3_banner_diff.dds" NEWTEXTURE="vehicles\textures\CustomLiveries\Honda_NSX_GT3\acura_nsx_gt3_banner51.dds" />		
		<REPLACE TEXTURE="vehicles\textures\acura_nsx_gt3_wheel_diff.dds" NEWTEXTURE="vehicles\textures\acura_nsx_gt3_wheel_dgrey_diff.dds" />
		<REPLACE TEXTURE="vehicles\textures\acura_nsx_gt3_wheel_spec.dds" NEWTEXTURE="vehicles\textures\acura_nsx_gt3_wheel_dgrey_spec.dds" />
		<REPLACE TEXTURE="vehicles\textures\acura_nsx_gt3_wheel_blur_diff.dds" NEWTEXTURE="vehicles\textures\acura_nsx_gt3_wheel_dgrey_blur_diff.dds" />
		<REPLACE TEXTURE="vehicles\textures\acura_nsx_gt3_wheel_blur_spec.dds" NEWTEXTURE="vehicles\textures\acura_nsx_gt3_wheel_dgrey_blur_spec.dds" />
		<REPLACE TEXTURE="vehicles\textures\common_tire_diff.dds" NEWTEXTURE="vehicles\textures\tire_pirelli_gt3_diff_00.dds" />
