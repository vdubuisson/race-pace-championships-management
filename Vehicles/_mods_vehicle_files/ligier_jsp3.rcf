		<NAME LIVERY="77" NAME="ELMS 2017 Eurointernational #11"/>
		<NAME LIVERY="78" NAME="ELMS 2017 Eurointernational #12"/>
		<NAME LIVERY="79" NAME="IMSA 2017 Eurointernational #11"/>
