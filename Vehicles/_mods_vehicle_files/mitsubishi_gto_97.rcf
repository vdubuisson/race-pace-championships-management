	<INPUTS>
		<INPUT NAME="LIVERY" OPTIONS="8" />
		<INPUT NAME="TIRE" OPTIONS="6" />
		<INPUT NAME="DIRTTYPE" OPTIONS="3" />
	</INPUTS>

	<NAMES INPUT ="LIVERY">
		<NAME LIVERY="51" NAME="black" />
		<NAME LIVERY="52" NAME="black_brims" />
		<NAME LIVERY="53" NAME="blue" />
		<NAME LIVERY="54" NAME="blue_brims" />
		<NAME LIVERY="55" NAME="red" />
		<NAME LIVERY="56" NAME="red_brims" />
		<NAME LIVERY="57" NAME="white" />
		<NAME LIVERY="58" NAME="white_brims" />
	</NAMES>

	<NAMES INPUT ="TIRE">
