	<INPUTS>
		<INPUT NAME="LIVERY" OPTIONS="10" />
		<INPUT NAME="TIRE" OPTIONS="6" />
		<INPUT NAME="DIRTTYPE" OPTIONS="3" />
	</INPUTS>

	<NAMES INPUT ="LIVERY">
		<NAME LIVERY="51" NAME="avio_1" />
		<NAME LIVERY="52" NAME="black_11" />
		<NAME LIVERY="53" NAME="blue_1" />
		<NAME LIVERY="54" NAME="bordeaux_45" />
