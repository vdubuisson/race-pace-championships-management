<?xml version="1.0" encoding="utf-8" ?>
<REPLACEMENT_SYSTEM>
	<!-- INPUTS section describes all inputs which can control selection of replacement items -->
	<INPUTS>
		<INPUT NAME="LIVERY" OPTIONS="27" />
		<INPUT NAME="TIRE" OPTIONS="6" />
		<INPUT NAME="DIRTTYPE" OPTIONS="3" />
	</INPUTS>

	<NAMES INPUT ="LIVERY">
		<NAME LIVERY="1" NAME="Inferno Orange Metallic" />
		<NAME LIVERY="2" NAME="Racing Red" />
		<NAME LIVERY="3" NAME="Furious Black Mica" />
		<NAME LIVERY="4" NAME="Speed Silver Metallic" />
		<NAME LIVERY="5" NAME="Rapid Blue Mica" />
		<NAME LIVERY="6" NAME="Dynamic White Pearl" />
		<NAME LIVERY="7" NAME="Asphalt Grey Metallic" />
		<NAME LIVERY="51" NAME="Classic livery #36" />
		<NAME LIVERY="52" NAME="Classic livery #6" />
		<NAME LIVERY="53" NAME="Classic livery #99" />
		<NAME LIVERY="54" NAME="Classic livery Yellow" />
		<NAME LIVERY="55" NAME="Classic livery #33" />
		<NAME LIVERY="56" NAME="Gigabyte Aorus" />
		<NAME LIVERY="57" NAME="Red Metallic/Black Stripes" />
		<NAME LIVERY="58" NAME="Silver Metallic/Yellow Stripes" />
		<NAME LIVERY="59" NAME="Spicy Orange/Black Stripes" />
		<NAME LIVERY="60" NAME="Blue Metallic/Green Stripes" />
		<NAME LIVERY="61" NAME="White/Black Stripes" />
		<NAME LIVERY="62" NAME="Black/Fluo Stripes" />
		<NAME LIVERY="63" NAME="Yellow Metallic" />
		<NAME LIVERY="64" NAME="Light Blue Metallic" />
		<NAME LIVERY="65" NAME="Green Metallic/Black Stripes" />
		<NAME LIVERY="66" NAME="Bronze Metallic/Black Stripes" />
		<NAME LIVERY="67" NAME="Purple Metallic/Yellow Stripes" />
		<NAME LIVERY="68" NAME="Street Racing Edition" />
		<NAME LIVERY="69" NAME="Chrome/Orange Stripes" />	
		<NAME LIVERY="70" NAME="Neon/Black Stripes" />
		
	</NAMES>

	<NAMES INPUT ="TIRE">
		<NAME TIRE="1" NAME="Soft" />
		<NAME TIRE="2" NAME="Medium" />
		<NAME TIRE="3" NAME="Hard" />
		<NAME TIRE="4" NAME="Intermediate" />
		<NAME TIRE="5" NAME="Wet" />
		<NAME TIRE="6" NAME="Extreme" />
	</NAMES>

	<NAMES INPUT ="DIRTTYPE">
		<NAME DIRTTYPE="1" NAME="Dirt" />
		<NAME DIRTTYPE="2" NAME="Snow" />
		<NAME DIRTTYPE="3" NAME="Mud" />
	</NAMES>

	<!-- DEPENDENCY section describes inputs which depend on each other in that only some combinations are permitted -->
	<!-- this will only be used in game for the menu system, and in the editor -->

	<!-- CONDITION sections define what to replace and when to replace it		-->
	<!-- They are used in the same way for all situations				-->
	
	<!-- Simple case - exterior paint effecting two materials -->
	<CONDITION LIVERY="1">
		<REPLACE MATERIAL="vehicles\toyota_gt86\toy_gt86_13_paint" NEWMATERIAL="vehicles\_generic_materials\paint_toyota_inferno_orange.mtx" />
		<REPLACE MATERIAL="vehicles\toyota_gt86\toy_gt86_13_paint_skin" NEWMATERIAL="vehicles\_generic_materials\paint_toyota_inferno_orange_autoskin.mtx" />
